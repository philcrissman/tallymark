# Copy to tallymark.env (git-ignored) and fill in. scripts/deploy.sh reads it.

# Required: the key you'll type into the dashboard. Generate one with:
#   openssl rand -hex 32
TALLYMARK_API_KEY=

# Comma-separated site IDs the /track endpoint will accept. Empty = accept any.
TALLYMARK_ALLOWED_SITES=example.com

# CloudFormation stack name and AWS region.
TALLYMARK_STACK_NAME=tallymark
TALLYMARK_REGION=us-east-1

# Optional fixed resource names. Leave empty and CloudFormation picks unique ones.
# Set these only if you're adopting an existing table/bucket.
TALLYMARK_TABLE_NAME=
TALLYMARK_DASHBOARD_BUCKET=
